{
  "name": "functions",
  "private": true,
  "description": "Moneymind Cloud Functions — AI callables, auth triggers, schedulers.",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src",
    "test": "jest",
    "serve": "pnpm build && firebase emulators:start --only auth,functions,firestore",
    "shell": "pnpm build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^7.2.5",
    "openai": "^4.77.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/jest": "^30.0.0",
    "eslint": "^9.18.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
