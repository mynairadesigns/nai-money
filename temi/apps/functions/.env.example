# Copy to apps/functions/.env and fill in. Firebase loads this file at deploy.
# The SECRET key is NOT set here — use:
#   firebase functions:secrets:set PAYSTACK_SECRET_KEY

# Plan codes from Paystack dashboard → Products → Plans (start with PLN_)
PAYSTACK_PLAN_MONTHLY=PLN_xxxxxxxxxxxxxxx
PAYSTACK_PLAN_YEARLY=PLN_xxxxxxxxxxxxxxx

# Lifetime price in KOBO (₦45,000 = 4500000). 0 hides the lifetime option.
PAYSTACK_LIFETIME_AMOUNT=4500000
PAYSTACK_CURRENCY=NGN

# Where your web app is hosted (comma-separated). Paystack only returns here.
PAYSTACK_ALLOWED_ORIGINS=https://app.yourdomain.com,https://your-project.web.app
