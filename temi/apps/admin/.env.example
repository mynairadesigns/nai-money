# Temi Finance admin panel — environment template.
#
# THIS FILE IS COMMITTED AND SHIPS TO BUYERS. Keep it placeholders only.
# Put your real values in `.env.local`, which is gitignored:
#
#   cp apps/admin/.env.example apps/admin/.env.local
#
# Next.js loads `.env.local` ahead of `.env`, so it always wins. It never
# loads `.env.example` — editing this file has no effect on the running app.

# --- Firebase web app config -------------------------------------------------
# Firebase console → Project settings → Your apps → Web app → SDK setup.
# These are public identifiers, not secrets — but they are YOUR project's, so
# they belong in .env.local rather than here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Server-side credentials -------------------------------------------------
# LOCAL: prefer Application Default Credentials — no key file to leak.
#   gcloud auth application-default login
#
# Or point at a downloaded service-account key (keep it outside the repo):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
# VERCEL: there is no Google metadata server, so ADC does not exist and the
# Admin SDK cannot authenticate on its own. You must supply a service-account
# key as an environment variable — the whole JSON, on one line:
#
#   FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
#
# Create it at Firebase console → Project settings → Service accounts →
# Generate new private key. Add it in Vercel under Settings → Environment
# Variables and mark it SENSITIVE. It is a real credential with full admin
# access to your project: never commit it, never put it in a NEXT_PUBLIC_*
# variable, and rotate it if it is ever exposed.
#
# The key is only needed where ADC is unavailable. On Cloud Run or any Google
# runtime, leave it unset and the runtime service account is used instead.

# --- Firebase emulators (optional local development) -------------------------
# Start with `firebase emulators:start` from the repo root, then uncomment.
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIRESTORE_EMULATOR_HOST=localhost:8080
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# --- Demo mode ---------------------------------------------------------------
# `true` makes the panel read-only: every page renders, but Remote Config
# publishing, admin grant/revoke, and entitlement refresh are all refused.
# Enforced on the server, not just hidden in the UI.
#
# Inlined at build time, so changing it requires a rebuild — on App Hosting
# that means a new rollout, not just an environment edit.
# NEXT_PUBLIC_DEMO_MODE=false

# --- Optional integrations ---------------------------------------------------
# Enables the live RevenueCat lookup on the user detail page. Without it the
# panel still shows the Firestore entitlement mirror.
# REVENUECAT_API_KEY=
