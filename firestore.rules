rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Client may read its own AI quota counters; only Functions (admin SDK) may write.
      match /aiUsage/{yearMonth} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // All other subcollections (wallets, transactions, categories, budgets, etc.)
      // are strictly owner-scoped per PRD §10. Use a recursive wildcard so
      // nested paths like aiChats/{sessionId}/messages/{msgId} (P5.1) are
      // covered too.
      match /{subcollection}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Admin-panel collections. The panel reads these exclusively through the
    // Firebase Admin SDK server-side, which bypasses these rules — so no
    // client, admin or otherwise, ever needs access. Unlisted paths already
    // default-deny; these blocks are written out so the intent is explicit
    // rather than incidental.
    match /adminStatsDaily/{document=**}   { allow read, write: if false; }
    match /adminStatsMonthly/{document=**} { allow read, write: if false; }
    match /adminHeartbeats/{document=**}   { allow read, write: if false; }
    match /adminAuditLog/{document=**}     { allow read, write: if false; }
    match /adminUsers/{document=**}        { allow read, write: if false; }
    match /revenueCatEvents/{document=**}  { allow read, write: if false; }
  }
}
